# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 절대 커밋하지 않는다.

# Supabase — 프로젝트 생성 후 Settings > API 에서 확인
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role 키는 RLS 를 우회한다. ETL 전용이며 앱에 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 공공데이터포털 — https://www.data.go.kr
# 계정당 인증키는 1개이며, 데이터별로 '활용신청'을 걸면 그 키 하나로 전부 열린다.
# 국가동물보호정보시스템(15098931)과 한국관광공사 국문 관광정보(15101578)가 이 키를 공유한다.
# 반드시 'Decoding' 키를 넣는다. Encoding 키(%2B·%2F·%3D 가 보이는 쪽)를 넣으면
# 이중 인코딩으로 SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 난다.
DATA_GO_KR_KEY=

# (LOCALDATA_API_KEY 는 없앴다 — localdata.go.kr 이 2026-04-16 에 닫혔고 인허가 데이터는
#  공공데이터포털로 통합됐다. 2단계 미용업(15154944)도 위 DATA_GO_KR_KEY 로 부른다 · D-93)

# 카카오 개발자 — https://developers.kakao.com 내 애플리케이션 > 앱 키
# 읍면동 중심좌표와 좌표 결측분 지오코딩에 쓴다.
# 안드로이드 지도 SDK 가 쓰는 '네이티브 앱 키'가 아니라 'REST API 키'다.
# KAKAO_REST_API_KEY=
