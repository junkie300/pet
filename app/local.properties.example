# 이 파일을 local.properties 로 복사해서 값을 채운다. local.properties 는 커밋되지 않는다.
# Android Studio 로 프로젝트를 열면 sdk.dir 은 자동으로 채워진다.
# 경로 구분자는 역슬래시를 이스케이프하는 대신 슬래시(/)를 쓰는 편이 안전하다.
sdk.dir=C:/Users/<사용자>/AppData/Local/Android/Sdk

# Supabase — Project Settings > API
# ⚠️ anon(public) 키를 넣는다. service_role 키를 넣으면 앱에 그대로 노출된다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# 카카오 — developers.kakao.com > [앱] > [플랫폼 키] > [네이티브 앱 키]
# 지도(S-02)에만 쓴다. 길찾기·전화는 이 키 없이도 된다 (D-57).
# ⚠️ 이 키만으로는 부족하다. 콘솔에 **패키지명 + 키 해시**가 등록돼 있어야 지도가 뜬다 (D-69).
#    debug 키 해시 뽑는 법:
#    keytool -exportcert -alias androiddebugkey -keystore ~/.android/debug.keystore \
#      -storepass android -keypass android | openssl sha1 -binary | openssl base64
KAKAO_NATIVE_APP_KEY=
